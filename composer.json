{
   "name":"neckarpixel/contao-npgridtools-bundle",
   "type":"contao-bundle",
   "description":"npgridtools extension for Contao Open Source CMS - grid columns for the core Element Group content element",
   "license":"LGPL-3.0-or-later",
   "homepage":"https://github.com/neckarpixel/contao-npgridtools-bundle",
   "support":{
      "issues":"https://github.com/neckarpixel/contao-npgridtools-bundle/issues",
      "source":"https://github.com/neckarpixel/contao-npgridtools-bundle"
   },
   "authors":[
      {
         "name":"Neckarpixel",
         "homepage":"https://www.neckarpixel.de"
      }
   ],
   "minimum-stability":"stable",
   "require":{
      "php":"^8.1",
      "contao/core-bundle":"^5.0",
      "neckarpixel/contao-nprangeslider-bundle":"^1.0"
   },
   "conflict":{
      "contao/core":"*",
      "contao/manager-plugin":"<2.0 || >=3.0"
   },
   "require-dev":{
      "contao/manager-plugin":"^2.0",
      "friendsofphp/php-cs-fixer":"^3.0",
      "phpunit/phpunit":"^9.5",
      "symfony/phpunit-bridge":"^5.4 || ^6.0"
   },
   "autoload":{
      "psr-4":{
         "Neckarpixel\\NpgridtoolsBundle\\":"src/"
      }
   },
   "autoload-dev":{
      "psr-4":{
         "Neckarpixel\\NpgridtoolsBundle\\Tests\\":"tests/"
      }
   },
   "extra":{
      "contao-manager-plugin":"Neckarpixel\\NpgridtoolsBundle\\ContaoManager\\Plugin"
   }
}
